
# Account number shown on https://myaccount.contact.co.nz/home of your bill
ACCOUNT_ID=
# In browser when viewing usage, look for request https://api.contact-digital-prod.net/usage/v2/{ACCOUNT_ID}?ba={CONTRACT_ID}
CONTRACT_ID=

# Authenticate using API token. This is the "Authorization" header in the https://api.contact-digital-prod.net request
TOKEN=

# Genesis Energy bearer token. In browser when viewing usage on https://myaccount.genesisenergy.co.nz,
# look for a request to https://web-api.genesisenergy.co.nz/v2/private/electricity/site-usage
# and copy the "authorization" header value (without the leading "Bearer "). Expires after 1 hour.
GENESIS_TOKEN=
